# Variables de entorno para ejecución LOCAL (opcional)
# En GitHub Actions NO necesitas este archivo:
# Solo requieres el secret AWS_ROLE_ARN en GitHub Settings.

# Región de AWS
AWS_REGION=us-east-1

# Buckets S3 (coinciden con infra/storage/terraform.tfvars)
RAW_BUCKET=sunat-risk-scoring-raw
BRONZE_BUCKET=sunat-risk-scoring-bronze
SILVER_BUCKET=sunat-risk-scoring-silver
GOLD_BUCKET=sunat-risk-scoring-gold
ARTIFACTS_BUCKET=sunat-risk-scoring-artifacts

# Opcional (fallback para resolución de nombres)
DATALAKE_BUCKET=sunat-risk-scoring
