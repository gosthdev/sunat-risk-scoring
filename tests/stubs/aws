#!/usr/bin/env bash
# Doble de `aws` para probar 05_submit_spark_steps.sh sin tocar AWS.
# Registra cada llamada en $AWS_LOG. Variables de control:
#   AWS_STATES_FILE : un estado de Job Run por línea; se consume uno por consulta
#                     (el último se repite).
#   AWS_RAW_BYTES=n : `s3 ls --summarize` de cada fuente RAW informa n bytes.
#   AWS_RAW_LS_ERROR=1 : `s3 ls --summarize` falla.
#   AWS_EMPTY_STAGING=1 : `s3 ls` sobre _staging no devuelve objetos.
#   AWS_EMPTY_MATCH=txt : `s3 ls` sobre _staging cuya ruta contiene txt no devuelve objetos.
#   AWS_LS_ERROR=1 : `s3 ls` sobre _staging falla (código 255), como un error de credenciales.
#   AWS_GET_FAIL=1 : `get-job-run` (estado) falla siempre.
#   AWS_FAIL_FIRST=n : las primeras n consultas de estado de `get-job-run` fallan.
#   AWS_SYNC_FAIL=1 : `s3 sync` falla siempre.
all="$*"
echo "${all//$'\n'/ }" >> "$AWS_LOG"

case "$1 $2" in
  "emr-serverless start-job-run")
    echo "jr-$(wc -l < "$AWS_LOG" | tr -d ' ')"
    ;;
  "emr-serverless get-job-run")
    if [[ "$*" == *stateDetails* ]]; then
      echo "stub: job failed"
    else
      if [[ "${AWS_GET_FAIL:-0}" == "1" ]]; then exit 255; fi
      if [[ -n "${AWS_FAIL_FIRST:-}" ]]; then
        hechos="$(cat "$AWS_LOG.failcount" 2>/dev/null || echo 0)"
        if (( hechos < AWS_FAIL_FIRST )); then
          echo $((hechos + 1)) > "$AWS_LOG.failcount"
          exit 255
        fi
      fi
      state="$(head -n 1 "$AWS_STATES_FILE")"
      if [[ "$(wc -l < "$AWS_STATES_FILE")" -gt 1 ]]; then
        tail -n +2 "$AWS_STATES_FILE" > "$AWS_STATES_FILE.tmp" && mv "$AWS_STATES_FILE.tmp" "$AWS_STATES_FILE"
      fi
      echo "$state"
    fi
    ;;
  "s3 sync")
    if [[ "${AWS_SYNC_FAIL:-0}" == "1" ]]; then exit 1; fi
    ;;
  "s3 ls")
    if [[ "$3" == *_staging* && "${AWS_LS_ERROR:-0}" == "1" ]]; then
      exit 255
    fi
    if [[ "$*" == *--summarize* ]]; then
      if [[ "${AWS_RAW_LS_ERROR:-0}" == "1" ]]; then exit 255; fi
      if [[ -n "${AWS_RAW_BYTES:-}" ]]; then
        printf '\nTotal Objects: 1\n   Total Size: %s\n' "$AWS_RAW_BYTES"
      fi
      exit 0
    fi
    if [[ "$3" == *_staging* && "${AWS_EMPTY_STAGING:-0}" == "1" ]]; then
      exit 0
    fi
    if [[ "$3" == *_staging* && -n "${AWS_EMPTY_MATCH:-}" && "$3" == *"$AWS_EMPTY_MATCH"* ]]; then
      exit 0
    fi
    echo "2026-10-11 10:00:00       123 part-0000.parquet"
    ;;
esac
exit 0
