# Configuración de entorno para Experimento E2 (Persistencia vs Doble Lectura CSV)
EXPERIMENT_NAME="E2"
PROFILE="C3"

# RAW apunta a los crudos reales (estrictamente solo lectura)
RAW_BUCKET="sunat-risk-scoring-raw"

# Las capas de escritura apuntan al bucket efímero de prueba
BRONZE_BUCKET="sunat-risk-scoring-perf-e2"
SILVER_BUCKET="sunat-risk-scoring-perf-e2"
GOLD_BUCKET="sunat-risk-scoring-perf-e2"
DATALAKE_BUCKET="sunat-risk-scoring-perf-e2"

# Parámetros de shuffle estándar
PERF_SHUFFLE_PARTITIONS=64
