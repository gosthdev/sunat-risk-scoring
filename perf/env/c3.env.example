# Perfil C3: 3 executors de 4 vCPU y 14 GB (fijando el número sin auto-scaling)
PROFILE_NAME="C3"

SPARK_DRIVER_CORES=4
SPARK_DRIVER_MEMORY="14g"
SPARK_EXECUTOR_CORES=4
SPARK_EXECUTOR_MEMORY="14g"
SPARK_EXECUTOR_INSTANCES=3
SPARK_DYNAMIC_ALLOCATION="false"
SPARK_EXECUTOR_DISK="100g"

# Configuración S3A para prevenir saturación de disco local (/mnt/s3) en escrituras pesadas
S3A_FAST_UPLOAD_BUFFER="bytebuffer"
S3A_MULTIPART_SIZE="64M"
