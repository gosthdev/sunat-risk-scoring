aws_region  = "us-east-1"
aws_profile = "bigdata"
project_tag = "sunat-risk-scoring"
environment = "perf"

# Nombres de buckets de pruebas (deben ser únicos)
bucket_perf_36p  = "sunat-risk-scoring-perf-36p"
bucket_perf_36n  = "sunat-risk-scoring-perf-36n"
bucket_perf_e2   = "sunat-risk-scoring-perf-e2"
bucket_perf_x1   = "sunat-risk-scoring-perf-x1"
bucket_perf_x10  = "sunat-risk-scoring-perf-x10"
bucket_perf_x100 = "sunat-risk-scoring-perf-x100"

# Buckets reales de producción (solo lectura)
raw_bucket_name       = "sunat-risk-scoring-raw"
bronze_bucket_name    = "sunat-risk-scoring-bronze"
silver_bucket_name    = "sunat-risk-scoring-silver"
gold_bucket_name      = "sunat-risk-scoring-gold"
artifacts_bucket_name = "sunat-risk-scoring-artifacts"

# EMR Serverless
emr_release_label        = "emr-7.13.0"
emr_max_cpu              = "32 vCPU"
emr_max_memory           = "128 GB"
emr_max_disk             = "500 GB"
emr_idle_timeout_minutes = 15

# Presupuesto
budget_limit_amount        = "100.0"
budget_notification_emails = []
force_destroy_buckets      = true
